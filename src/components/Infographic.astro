---
// Infographie partageable : image + code d'intégration avec crédit vers la page hôte (source de backlinks).
import { SITE } from '../data/site';
import { abs } from '../lib/schema';
import { getInfographic, hostPath, png, webp, WIDTH, HEIGHT } from '../data/infographics';
interface Props { slug: string; heading?: string }
const g = getInfographic(Astro.props.slug);
const page = abs(hostPath(g));
const code =
  `<a href="${page}"><img src="${abs(png(g))}" alt="${g.alt}" width="${WIDTH}" height="${HEIGHT}" style="max-width:100%;height:auto" loading="lazy"></a>\n` +
  `<p style="font-size:13px">Source : <a href="${page}">${g.title}, ${SITE.name}</a></p>`;
const id = `infographie-${g.slug}`;
---
<section class="infographic-block" id="infographie" aria-labelledby={Astro.props.heading ? id + '-h' : undefined}>
  {Astro.props.heading && <h2 id={id + '-h'}>{Astro.props.heading}</h2>}
  <figure class="capture infographic">
    <img src={webp(g)} alt={g.alt} width={WIDTH} height={HEIGHT} loading="lazy" decoding="async" />
    <figcaption>{g.title}. Réutilisation libre avec mention de la source.</figcaption>
  </figure>
  <div class="embed-box">
    <h3 id={id} style="margin-top:0">Partage cette infographie</h3>
    <p>Tu peux la publier sur ton site, ton blog ou ton intranet, gratuitement, en gardant le lien vers la source. Copie ce code dans un bloc HTML, ou <a href={png(g)} download>télécharge l’image</a> pour LinkedIn ou une présentation. <a href="/infographies/">Toutes nos infographies</a>.</p>
    <textarea readonly aria-label="Code d’intégration de l’infographie">{code}</textarea>
    <div class="row"><button type="button" class="btn btn-sm" data-copy>Copier le code</button><span class="small muted" aria-live="polite"></span></div>
  </div>
</section>
<script is:inline>
  document.querySelectorAll('[data-copy]').forEach((b) => {
    if (b.dataset.ready) return;
    b.dataset.ready = '1';
    b.addEventListener('click', async () => {
      const box = b.closest('.embed-box'), ta = box.querySelector('textarea'), msg = box.querySelector('[aria-live]');
      try { await navigator.clipboard.writeText(ta.value); msg.textContent = 'Code copié.'; }
      catch { ta.select(); msg.textContent = 'Sélectionne le code puis copie-le (Ctrl+C).'; }
    });
  });
</script>
