---
import { SITE } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/restaurant/', label: 'Restaurant' },
  { href: '/facturation/', label: 'Facturation' },
  { href: '/comparatifs/', label: 'Comparatifs' },
  { href: '/outils/', label: 'Outils gratuits' },
];
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${SITE.name}, accueil`}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="#c2410c" d="M16 2c1 5 6 7 6 13a6 6 0 0 1-12 0c0-3 2-5 3-7 0 3 1 4 3 5 0-4-2-7 0-11zM6 22h20v3a5 5 0 0 1-5 5H11a5 5 0 0 1-5-5z"/></svg>
      {SITE.name}
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
