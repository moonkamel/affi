---
import { SITE } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/facturation/', label: 'Facturation' },
  { href: '/comptabilite/', label: 'Compta' },
  { href: '/encaissement/', label: 'Encaissement' },
  { href: '/site-internet/', label: 'Site web' },
  { href: '/crm/', label: 'CRM' },
  { href: '/metiers/', label: 'Par métier' },
  { href: '/outils/', label: 'Outils gratuits' },
];
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${SITE.name}, accueil`}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#2747d8"/><path d="M10.5 8v15h11" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M22.5 6.5l1.1 2.6 2.6 1.1-2.6 1.1-1.1 2.6-1.1-2.6-2.6-1.1 2.6-1.1z" fill="#f4ad1f"/></svg>
      {SITE.name}
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Basculer entre thème clair et sombre">
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg>
    </button>
  </div>
</header>
<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('logimalin-theme', next); } catch {}
    });
  })();
</script>
