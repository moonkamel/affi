---
import { SITE } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/facturation/', label: 'Facturation' },
  { href: '/comptabilite/', label: 'Compta' },
  { href: '/encaissement/', label: 'Encaissement' },
  { href: '/site-internet/', label: 'Site web' },
  { href: '/crm/', label: 'CRM' },
  { href: '/metiers/', label: 'Par métier' },
];
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${SITE.name}, accueil`}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#1e40af"/><path d="M10.5 8v15h11" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M22.5 6.5l1.1 2.6 2.6 1.1-2.6 1.1-1.1 2.6-1.1-2.6-2.6-1.1 2.6-1.1z" fill="#fbbf24"/></svg>
      {SITE.name}
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
