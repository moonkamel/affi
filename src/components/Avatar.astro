---
// Pastille de signature : le logo Logimalin (le site est signé par l'équipe, sans photo de personne).
interface Props { size?: number }
const { size = 52 } = Astro.props;
---
<svg class="avatar" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" style={`background:none;box-shadow:none;border-radius:22%;flex:0 0 ${size}px;width:${size}px;height:${size}px`}><rect width="32" height="32" rx="8" fill="#2747d8"/><path d="M10.5 8v15h11" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M22.5 6.5l1.1 2.6 2.6 1.1-2.6 1.1-1.1 2.6-1.1-2.6-2.6-1.1 2.6-1.1z" fill="#f4ad1f"/></svg>
