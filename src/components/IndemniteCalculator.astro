---
// Indemnité légale de licenciement ou indemnité spécifique de rupture conventionnelle (minimum légal),
// avec le coût pour l'employeur. Règles : articles L. 1234-9 et R. 1234-2 du Code du travail ;
// contribution patronale spécifique de 40 % sur les indemnités de rupture conventionnelle depuis le 1er janvier 2026.
interface Props { mode?: 'rupture' | 'licenciement' }
const { mode = 'rupture' } = Astro.props;
const CONTRIBUTION = 0.4;
---
<form class="sim" id="sim-indem" data-mode={mode} aria-labelledby="indem-titre" onsubmit="return false">
  <strong id="indem-titre">{mode === 'rupture' ? 'Simulateur d’indemnité de rupture conventionnelle' : 'Calcul de l’indemnité de licenciement'}</strong>
  <div class="row">
    <div>
      <label for="indem-type">Situation</label>
      <select id="indem-type">
        <option value="rupture" selected={mode === 'rupture'}>Rupture conventionnelle</option>
        <option value="licenciement" selected={mode === 'licenciement'}>Licenciement (motif personnel ou économique)</option>
        <option value="faute">Licenciement pour faute grave ou lourde</option>
      </select>
    </div>
    <div><label for="indem-entree">Date d’entrée dans l’entreprise</label><input id="indem-entree" type="date" value="2019-03-01" /></div>
    <div>
      <label for="indem-fin" id="indem-fin-l">Date de fin du contrat</label>
      <input id="indem-fin" type="date" value="2026-12-31" />
      <p class="hint" id="indem-fin-h">Pour un licenciement : fin du préavis, même s’il n’est pas effectué.</p>
    </div>
    <div><label for="indem-s12">Salaire brut mensuel moyen des 12 derniers mois (€)</label><input id="indem-s12" type="number" min="0" step="10" value="2500" inputmode="decimal" /></div>
    <div><label for="indem-s3">Salaire brut mensuel moyen des 3 derniers mois (€)</label><input id="indem-s3" type="number" min="0" step="10" value="2600" inputmode="decimal" /><p class="hint">Primes annuelles comptées au prorata (une prime de 1 200 € compte pour 300 € sur 3 mois).</p></div>
    <div data-rupture><label for="indem-nego">Indemnité négociée, si elle dépasse le minimum (€)</label><input id="indem-nego" type="number" min="0" step="100" placeholder="Facultatif" inputmode="decimal" /></div>
  </div>
  <output class="sim-out" aria-live="polite">
    <div id="indem-l">Indemnité minimale</div>
    <div class="big" id="indem-r">–</div>
    <div id="indem-d" class="small"></div>
  </output>
  <table class="sim-tab"><tbody id="indem-tab"></tbody></table>
  <p class="hint">Minimum légal. Ta convention collective peut prévoir une indemnité plus élevée : c’est alors elle qui s’applique.</p>
</form>

<script is:inline define:vars={{ CONTRIBUTION }}>
  (() => {
    const f = document.getElementById('sim-indem');
    if (!f) return;
    const $ = (id) => document.getElementById(`indem-${id}`);
    const num = (id) => { const x = parseFloat(String($(id).value).replace(',', '.')); return Number.isFinite(x) && x >= 0 ? x : 0; };
    const eur = (n) => n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const ligne = (k, v, cls) => { const tr = document.createElement('tr'); if (cls) tr.className = cls; const th = document.createElement('th'); th.textContent = k; const td = document.createElement('td'); td.textContent = v; tr.append(th, td); return tr; };
    // Ancienneté en années et mois complets, de la date d'entrée à la date de fin du contrat.
    const anciennete = (a, b) => {
      let mois = (b.getFullYear() - a.getFullYear()) * 12 + (b.getMonth() - a.getMonth());
      if (b.getDate() < a.getDate()) mois -= 1;
      return Math.max(0, mois);
    };
    const duree = (m) => [Math.floor(m / 12) ? `${Math.floor(m / 12)} an${Math.floor(m / 12) > 1 ? 's' : ''}` : '', m % 12 ? `${m % 12} mois` : ''].filter(Boolean).join(' et ') || 'moins d’un mois';
    let compte = false;

    const calc = (e) => {
      const type = $('type').value;
      f.querySelectorAll('[data-rupture]').forEach((x) => { x.hidden = type !== 'rupture'; });
      $('fin-h').hidden = type === 'rupture';
      const debut = new Date($('entree').value), fin = new Date($('fin').value);
      if (isNaN(debut) || isNaN(fin) || fin <= debut) { $('r').textContent = '–'; $('d').textContent = 'Renseigne des dates valides.'; $('tab').replaceChildren(); return; }
      if (!compte && e) { compte = true; try { navigator.sendBeacon(`/api/mesure/indemnite-${type}`); } catch (err) { /* sans importance */ } }
      const m = anciennete(debut, fin), ans = m / 12;
      const ref = Math.max(num('s12'), num('s3'));
      const legale = ref * (Math.min(ans, 10) / 4 + Math.max(ans - 10, 0) / 3);
      const lignes = [ligne('Ancienneté', duree(m)), ligne('Salaire de référence (le plus favorable des deux moyennes)', eur(ref)),
        ligne('Calcul', ans <= 10 ? `${eur(ref)} × 1/4 × ${ans.toLocaleString('fr-FR', { maximumFractionDigits: 2 })} an(s)` : `${eur(ref)} × (1/4 × 10 + 1/3 × ${(ans - 10).toLocaleString('fr-FR', { maximumFractionDigits: 2 })})`)];

      if (type === 'faute') {
        $('l').textContent = 'Indemnité de licenciement'; $('r').textContent = eur(0);
        $('d').textContent = 'Pas d’indemnité légale en cas de faute grave ou lourde. Les congés payés acquis restent dus.';
        $('tab').replaceChildren(ligne('Ancienneté', duree(m))); return;
      }
      if (type === 'licenciement') {
        $('l').textContent = 'Indemnité légale de licenciement';
        if (m < 8) { $('r').textContent = eur(0); $('d').textContent = `Ancienneté de ${duree(m)} : il faut au moins 8 mois d’ancienneté ininterrompue pour avoir droit à l’indemnité légale (une indemnité conventionnelle peut exister).`; $('tab').replaceChildren(...lignes.slice(0, 2)); return; }
        const preavis = m < 6 ? 'selon la convention collective ou l’usage' : m < 24 ? '1 mois' : '2 mois';
        $('r').textContent = eur(legale);
        $('d').textContent = `Minimum à verser pour ${duree(m)} d’ancienneté. Indemnité exonérée de cotisations dans les limites légales : pas de contribution patronale spécifique.`;
        lignes.push(ligne('Indemnité légale de licenciement', eur(legale), 'tot'), ligne('Préavis légal', preavis));
      } else {
        const nego = num('nego'), versee = Math.max(legale, nego), contrib = versee * CONTRIBUTION;
        $('l').textContent = 'Indemnité minimale de rupture conventionnelle';
        $('r').textContent = eur(legale);
        $('d').textContent = (nego && nego < legale ? `Attention : ${eur(nego)} est inférieur au minimum légal, la rupture ne serait pas homologuée. ` : '')
          + `Coût estimé pour l’employeur : ${eur(versee + contrib)}, contribution patronale de 40 % comprise.`;
        lignes.push(ligne('Indemnité minimale (égale à l’indemnité légale de licenciement)', eur(legale)));
        if (nego > legale) lignes.push(ligne('Indemnité négociée', eur(nego)));
        lignes.push(ligne('Contribution patronale spécifique (40 %)', eur(contrib)), ligne('Coût total pour l’employeur', eur(versee + contrib), 'tot'));
      }
      $('tab').replaceChildren(...lignes);
    };
    f.addEventListener('input', calc);
    f.addEventListener('change', calc);
    calc();
  })();
</script>

<style>
  #sim-indem [hidden] { display: none !important; }
</style>
