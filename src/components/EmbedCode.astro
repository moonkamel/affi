---
// Boîte « Intègre ce simulateur sur ton site » : génère le code iframe + lien de crédit.
import { getEmbed } from '../data/embeds';
import { SITE } from '../data/site';
import { abs } from '../lib/schema';
interface Props { tool: string }
const e = getEmbed(Astro.props.tool);
const origin = new URL(SITE.url).origin;
const data = { slug: e.slug, src: abs(`/embed/${e.slug}/`), page: abs(e.page), title: e.title, height: e.height, origin, name: SITE.name };
---
<section class="embed-box" aria-labelledby={`integrer-${e.slug}`} data-embed={JSON.stringify(data)}>
  <h2 id={`integrer-${e.slug}`} style="margin-top:0">Intègre ce simulateur sur ton site</h2>
  <p>Tu as un blog, un cabinet comptable ou un site pour entrepreneurs ? Ajoute ce simulateur gratuitement : copie le code ci-dessous et colle-le dans ta page (bloc HTML). Il reste à jour automatiquement.</p>
  <div class="row">
    <span>Thème :</span>
    <label><input type="radio" name={`theme-${e.slug}`} value="light" checked /> clair</label>
    <label><input type="radio" name={`theme-${e.slug}`} value="dark" /> sombre</label>
  </div>
  <textarea readonly aria-label="Code d’intégration du simulateur"></textarea>
  <div class="row"><button type="button" class="btn btn-sm">Copier le code</button><span class="small muted" aria-live="polite"></span></div>
  <p class="small muted" style="margin-bottom:0">Conditions : utilisation gratuite, en conservant la mention de la source. <a href={`/embed/${e.slug}/?theme=light`} target="_blank" rel="noopener nofollow">Aperçu</a></p>
</section>

<script is:inline>
  document.querySelectorAll('.embed-box').forEach((box) => {
    if (box.dataset.ready) return;
    box.dataset.ready = '1';
    const d = JSON.parse(box.dataset.embed);
    const ta = box.querySelector('textarea');
    const id = 'logimalin-' + d.slug;
    const render = () => {
      const theme = box.querySelector('input[type=radio]:checked').value;
      ta.value =
        `<iframe id="${id}" src="${d.src}${theme === 'light' ? '?theme=light' : ''}" title="${d.title}" width="100%" height="${d.height}" style="border:0;max-width:760px" loading="lazy"></iframe>\n` +
        `<p style="font-size:13px">${d.title} par <a href="${d.page}">${d.name}</a></p>\n` +
        `<script>addEventListener('message',function(e){if(e.origin==='${d.origin}'&&e.data&&e.data.logimalin==='${d.slug}'){document.getElementById('${id}').style.height=e.data.h+'px'}})<\/script>`;
    };
    box.addEventListener('change', render);
    box.querySelector('button').addEventListener('click', async () => {
      const msg = box.querySelector('[aria-live]');
      try { await navigator.clipboard.writeText(ta.value); msg.textContent = 'Code copié.'; }
      catch { ta.select(); msg.textContent = 'Sélectionne le code puis copie-le (Ctrl+C).'; }
    });
    render();
  });
</script>
