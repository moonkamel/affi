---
import { getCollection } from 'astro:content';
import { getSoftware } from '../data/software';
import AffLink from './AffLink.astro';
// level : 2 quand la fiche est placée avant le premier intertitre de l'article (pages avis), pour ne pas sauter de niveau.
interface Props { slug: string; rank?: number; reviewHref?: string; level?: 2 | 3 }
const { slug, rank, level = 3 } = Astro.props;
const Titre = level === 2 ? 'h2' : 'h3';
const s = getSoftware(slug);
// Lien automatique vers notre page d'avis du logiciel, si elle existe (maillage interne).
const review = (await getCollection('articles', (e) => !e.data.draft && e.data.review?.product === slug))[0];
const reviewHref = Astro.props.reviewHref ?? (review ? `/${review.id}/` : undefined);
const showReview = reviewHref && reviewHref !== Astro.url.pathname;
---
<section class="card" id={`logiciel-${s.slug}`}>
  <div class="card-head">
    <div>
      <Titre>{rank && <span class="rank">{rank}</span>}{s.name}</Titre>
      <div class="muted small">Idéal pour : {s.bestFor}</div>
      {s.badges && <div class="badges">{s.badges.map((b) => <span class="badge">{b}</span>)}</div>}
    </div>
    <div class="score" aria-label={`Note ${s.score} sur 10`}>{s.score.toFixed(1).replace('.', ',')}<small>/10</small></div>
  </div>
  <p>{s.short}</p>
  <slot />
  <div class="proscons">
    <div class="pros"><strong>Points forts</strong><ul>{s.pros.map((p) => <li>{p}</li>)}</ul></div>
    <div class="cons"><strong>Limites</strong><ul>{s.cons.map((p) => <li>{p}</li>)}</ul></div>
  </div>
  <div class="card-foot">
    <div class="small"><strong>Prix :</strong> {s.price.label}{s.price.note && <span class="muted"> ({s.price.note})</span>}</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      {showReview && <a class="btn btn-ghost btn-sm" href={reviewHref}>Lire l’avis {s.name}</a>}
      <AffLink slug={s.slug} size="sm" />
    </div>
  </div>
</section>
