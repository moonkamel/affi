---
// Vérifie la situation d'un micro-entrepreneur face aux seuils de franchise en base de TVA.
---
<form class="sim" id="sim-tva" aria-labelledby="tva-titre" onsubmit="return false">
  <strong id="tva-titre">Dois-tu facturer la TVA ?</strong>
  <div class="row">
    <div>
      <label for="tva-act">Activité principale</label>
      <select id="tva-act">
        <option value="services">Prestations de services, professions libérales</option>
        <option value="vente">Vente de marchandises, restauration, hébergement</option>
      </select>
    </div>
    <div>
      <label for="tva-n1">Chiffre d’affaires de l’année dernière (€)</label>
      <input id="tva-n1" type="number" min="0" value="28000" inputmode="decimal" />
    </div>
    <div>
      <label for="tva-n">Chiffre d’affaires de cette année, à ce jour (€)</label>
      <input id="tva-n" type="number" min="0" value="26000" inputmode="decimal" />
    </div>
    <div>
      <label for="tva-prev">Chiffre d’affaires prévu sur l’année entière (€)</label>
      <input id="tva-prev" type="number" min="0" value="39000" inputmode="decimal" />
    </div>
  </div>
  <output class="sim-out" for="tva-act tva-n1 tva-n tva-prev" aria-live="polite">
    <div>Ta situation</div>
    <div class="big" id="tva-r" style="font-size:1.6rem">–</div>
    <div id="tva-d" class="small"></div>
  </output>
</form>

<script is:inline>
  (() => {
    const f = document.getElementById('sim-tva');
    if (!f) return;
    const S = { services: [37500, 41250], vente: [85000, 93500] };
    const v = (id) => Math.max(0, parseFloat(String(document.getElementById(id).value).replace(',', '.')) || 0);
    const eur = (n) => n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const calc = () => {
      const [base, maj] = S[document.getElementById('tva-act').value];
      const n1 = v('tva-n1'), n = v('tva-n'), prev = Math.max(v('tva-prev'), n);
      let titre, detail;
      if (n1 > base) {
        titre = 'Tu factures la TVA cette année';
        detail = `Ton chiffre d’affaires de l’an dernier (${eur(n1)}) dépasse le seuil de ${eur(base)} : la franchise ne s’applique plus depuis le 1er janvier.`;
      } else if (n > maj) {
        titre = 'TVA due depuis le jour du dépassement';
        detail = `Tu as dépassé le seuil majoré de ${eur(maj)} : la facture qui a fait franchir le seuil et toutes les suivantes doivent inclure la TVA.`;
      } else if (prev > maj) {
        titre = 'Attention : dépassement prévu en cours d’année';
        detail = `À ce rythme, tu franchiras le seuil majoré de ${eur(maj)}. Il te reste <strong>${eur(maj - n)}</strong> de chiffre d’affaires en franchise : prépare dès maintenant des factures avec TVA.`;
      } else if (prev > base) {
        titre = 'Franchise cette année, TVA l’an prochain';
        detail = `Ton chiffre d’affaires prévu dépasse ${eur(base)} sans atteindre ${eur(maj)} : tu restes en franchise jusqu’au 31 décembre, puis tu factures la TVA à partir du 1er janvier.`;
      } else {
        titre = 'Franchise en base de TVA';
        detail = `Tu ne factures pas la TVA. Mention à porter sur tes factures : « TVA non applicable, art. 293 B du CGI ». Marge avant le seuil : <strong>${eur(base - prev)}</strong>.`;
      }
      document.getElementById('tva-r').textContent = titre;
      document.getElementById('tva-d').innerHTML = detail + `<br>Seuils utilisés : ${eur(base)} (base) et ${eur(maj)} (majoré).`;
    };
    f.addEventListener('input', calc);
    calc();
  })();
</script>
