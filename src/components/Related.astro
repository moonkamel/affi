---
interface Props { items: { href: string; title: string; description: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section aria-labelledby="a-lire">
    <h2 id="a-lire">À lire aussi</h2>
    <div class="grid">
      {items.map((it) => <a class="tile" href={it.href}><strong>{it.title}</strong><span>{it.description}</span></a>)}
    </div>
  </section>
)}
