---
// Dossier de financement : assemble l'étude de marché locale et le prévisionnel (sauvegardés dans le navigateur
// par MarketStudy et BusinessPlanBuilder) avec les parties rédigées du business plan, puis imprime un document A4.
// Rien n'est envoyé : les textes sont gardés en brouillon dans le navigateur (localStorage).
const sections = [
  { id: 'resume', titre: 'Résumé du projet', aide: 'Le projet en 5 lignes : ce que tu vends, à qui, où, le besoin de financement et le chiffre d’affaires visé. Écris-le en dernier.' },
  { id: 'parcours', titre: 'Le porteur de projet', aide: 'Ton parcours, tes compétences, ton expérience dans le métier, ce qui te rend crédible.' },
  { id: 'offre', titre: 'L’offre', aide: 'Tes produits ou services, tes prix, le problème que tu règles pour tes clients, ce qui te différencie.' },
  { id: 'marche', titre: 'Le marché et la clientèle', aide: 'Tes clients cibles, leurs besoins, tes concurrents principaux et ton positionnement. Les chiffres de ton étude de marché sont ajoutés automatiquement.' },
  { id: 'strategie', titre: 'La stratégie commerciale', aide: 'Comment tu trouves tes clients : emplacement, site internet, réseaux sociaux, prospection, partenaires, budget.' },
  { id: 'moyens', titre: 'Les moyens', aide: 'Statut juridique, local, matériel, logiciels, fournisseurs, recrutements prévus.' },
  { id: 'calendrier', titre: 'Le calendrier', aide: 'Les grandes étapes : immatriculation, travaux, ouverture, premiers clients, embauches.' },
];
const swot = [
  { id: 'forces', titre: 'Forces', aide: 'Ton expérience, ton emplacement, ton savoir-faire…' },
  { id: 'faiblesses', titre: 'Faiblesses', aide: 'Ce qui te manque encore : notoriété, trésorerie, compétence…' },
  { id: 'opportunites', titre: 'Opportunités', aide: 'Ce qui joue en ta faveur : quartier qui se développe, tendance, concurrent qui part…' },
  { id: 'menaces', titre: 'Menaces', aide: 'Ce qui peut te freiner : nouvelle enseigne, hausse des prix, saisonnalité…' },
];
---
<div class="sim dossier" id="dossier-tool">
  <strong>Ton dossier de financement</strong>
  <p class="small">Tes textes restent dans ton navigateur (brouillon enregistré automatiquement). Rien n’est envoyé.</p>

  <div class="ds-sources">
    <div id="ds-src-etude" class="ds-src"></div>
    <div id="ds-src-bp" class="ds-src"></div>
  </div>

  <fieldset>
    <legend>Le projet</legend>
    <div class="row">
      <div><label for="ds-nom">Nom du projet ou de l’entreprise</label><input id="ds-nom" type="text" placeholder="Ex. : Boulangerie du Port" /></div>
      <div><label for="ds-porteur">Porteur(s) du projet</label><input id="ds-porteur" type="text" placeholder="Prénom Nom" /></div>
      <div><label for="ds-ville">Ville</label><input id="ds-ville" type="text" /></div>
      <div>
        <label for="ds-statut">Forme juridique envisagée</label>
        <select id="ds-statut">
          <option value="">À définir</option>
          <option>Micro-entreprise</option><option>Entreprise individuelle (régime réel)</option>
          <option>EURL</option><option>SASU</option><option>SARL</option><option>SAS</option>
        </select>
      </div>
      <div><label for="ds-debut">Date de démarrage prévue</label><input id="ds-debut" type="month" /></div>
      <div><label for="ds-contact">Contact (e-mail ou téléphone)</label><input id="ds-contact" type="text" /></div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Les parties rédigées</legend>
    {sections.map((s) => (
      <div class="ds-sec">
        <label for={`ds-${s.id}`}>{s.titre}</label>
        <p class="small">{s.aide}</p>
        <textarea id={`ds-${s.id}`} rows="5"></textarea>
      </div>
    ))}
  </fieldset>

  <fieldset>
    <legend>Forces, faiblesses, opportunités, menaces (facultatif)</legend>
    <p class="small">Une à trois idées par case, une par ligne. Les financeurs apprécient ce tableau : il montre que tu connais aussi les risques.</p>
    <div class="row">
      {swot.map((s) => (
        <div><label for={`ds-${s.id}`}>{s.titre}</label><textarea id={`ds-${s.id}`} rows="3" placeholder={s.aide}></textarea></div>
      ))}
    </div>
  </fieldset>

  <div class="ds-actions">
    <button type="button" class="btn" id="ds-go">Générer et enregistrer mon dossier en PDF</button>
    <button type="button" class="btn btn-ghost" id="ds-apercu">Aperçu</button>
  </div>
  <p class="small">Dans la fenêtre d’impression, choisis « Enregistrer au format PDF » comme imprimante.</p>
</div>

<article id="dossier-doc" class="dossier-doc" hidden aria-label="Aperçu du dossier"></article>

<script is:inline define:vars={{ sections, swot }}>
  (() => {
    const root = document.getElementById('dossier-tool');
    if (!root) return;
    const $ = (id) => document.getElementById(id);
    const lire = (k) => { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return null; } };
    const dateFr = (iso) => new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    const eur = (n) => Number(n).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const champs = ['nom', 'porteur', 'ville', 'statut', 'debut', 'contact', ...sections.map((s) => s.id), ...swot.map((s) => s.id)];

    // ---------- Brouillon ----------
    const brouillon = lire('logimalin-dossier') || {};
    champs.forEach((k) => { if (brouillon[k] != null) $(`ds-${k}`).value = brouillon[k]; });
    root.addEventListener('input', () => {
      const d = {};
      champs.forEach((k) => { d[k] = $(`ds-${k}`).value; });
      try { localStorage.setItem('logimalin-dossier', JSON.stringify(d)); } catch (e) { /* stockage indisponible */ }
    });

    // ---------- Sources disponibles ----------
    const etude = lire('logimalin-etude');
    const bp = lire('logimalin-bp');
    if (etude && !$('ds-ville').value) $('ds-ville').value = (etude.commune || '').replace(/\s*\(.*\)$/, '');
    $('ds-src-etude').innerHTML = etude
      ? `✅ <strong>Étude de marché</strong> : ${etude.activite} à ${etude.commune}, le ${dateFr(etude.date)}. <a href="/creer/etude-de-marche/">Refaire</a>`
      : '⬜ <strong>Étude de marché</strong> : pas encore faite. <a href="/creer/etude-de-marche/">Lancer l’étude gratuite</a>';
    $('ds-src-bp').innerHTML = bp
      ? `✅ <strong>Prévisionnel</strong> : chiffre d’affaires de 1re année ${eur(bp.hypotheses.ca1)}, le ${dateFr(bp.date)}. <a href="/creer/business-plan/">Modifier</a>`
      : '⬜ <strong>Prévisionnel</strong> : pas encore fait. <a href="/creer/business-plan/">Faire le prévisionnel</a>';

    // ---------- Construction du document (DOM, sans HTML injecté) ----------
    const el = (tag, cls, txt) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; };
    const paragraphes = (parent, texte, vide) => {
      const t = (texte || '').trim();
      if (!t) { parent.appendChild(el('p', 'ds-vide', vide || 'À compléter.')); return; }
      t.split(/\n\s*\n|\n/).filter(Boolean).forEach((p) => parent.appendChild(el('p', null, p.trim())));
    };
    const tableau = (parent, entete, lignes, legende) => {
      const t = el('table', 'ds-table');
      if (legende) t.appendChild(el('caption', null, legende));
      const h = t.createTHead().insertRow();
      entete.forEach((x) => h.appendChild(el('th', null, x)));
      const b = t.createTBody();
      lignes.forEach((l) => { const r = b.insertRow(); l.forEach((x) => { r.insertCell().textContent = x; }); });
      parent.appendChild(t);
    };
    // Textes repris des outils (écrits au « tu ») rendus neutres pour un document destiné à un financeur.
    const neutre = (t) => {
      let x = String(t || '').replace(/^[^\p{L}\d]+/u, '').trim();
      x = x.split(/ : vérifie| : il te faudra|\. Soit la demande|\. Le marché est disputé|\. Ni désert/)[0];
      return x && !/[.!?)]$/.test(x) ? x + '.' : x;
    };
    const construire = () => {
      const doc = $('dossier-doc');
      doc.replaceChildren();
      const v = (k) => $(`ds-${k}`).value.trim();
      const nom = v('nom') || 'Mon projet';

      // Couverture
      const couv = el('section', 'ds-partie ds-couv');
      couv.appendChild(el('span', 'pdf-bande'));
      couv.appendChild(el('p', 'ds-sur', 'Dossier de présentation et de financement'));
      couv.appendChild(el('h1', null, nom));
      [
        ['Porteur du projet', v('porteur')], ['Ville', v('ville')], ['Forme juridique envisagée', v('statut')],
        ['Démarrage prévu', v('debut') ? new Date(v('debut') + '-01').toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' }) : ''],
        ['Activité', etude ? etude.activite : ''], ['Contact', v('contact')],
      ].filter(([, x]) => x).forEach(([k, x]) => { const p = el('p', 'ds-meta'); p.appendChild(el('strong', null, `${k} : `)); p.appendChild(document.createTextNode(x)); couv.appendChild(p); });
      couv.appendChild(el('p', 'ds-date', `Document établi le ${dateFr(new Date().toISOString())}`));
      const ligneCr = (re) => (bp && bp.cr.find((r) => re.test(r[0]))) || null;
      const cles = [];
      if (bp) {
        const apport = bp.ress.find((r) => /^Apport/.test(r[0]));
        cles.push(['Besoin de financement', eur(bp.totB), apport && bp.totB ? `dont ${Math.round((apport[1] / bp.totB) * 100)} % d’apport personnel` : '']);
        cles.push(['Chiffre d’affaires visé', eur(bp.hypotheses.ca1), 'en première année']);
        const res = ligneCr(/^Résultat/);
        if (res) cles.push(['Résultat avant impôt', eur(res[3]), `en 3e année (${eur(res[1])} la 1re)`]);
        if (bp.seuil) cles.push(['Seuil de rentabilité', eur(bp.seuil), bp.hypotheses.ca1 >= bp.seuil ? 'atteint dès la 1re année' : 'visé en 2e année']);
      }
      if (etude && etude.zones && etude.zones[0]) {
        const z = etude.zones[0], fr = etude.zones[etude.zones.length - 1];
        cles.push(['Concurrents dans la commune', z[2], `${z[3]} pour 10 000 habitants (France : ${fr[3]})`]);
      }
      if (etude && etude.ca) { const mCa = etude.ca.match(/médian : ([\d\s  ]+€)/); if (mCa) cles.push(['CA médian des concurrents', mCa[1], 'comptes publiés']); }
      if (cles.length) {
        couv.appendChild(el('h2', null, 'Le projet en chiffres'));
        const g = el('div', 'ds-cles');
        cles.forEach(([k, x, d]) => { const c = el('div', 'ds-tuile'); c.appendChild(el('span', 'ds-tk', k)); c.appendChild(el('strong', null, x)); if (d) c.appendChild(el('span', 'ds-td', d)); g.appendChild(c); });
        couv.appendChild(g);
      }
      const som = el('ol', 'ds-sommaire');
      ['Résumé du projet', 'Le porteur de projet', 'L’offre', 'Le marché et la clientèle', 'La stratégie commerciale', 'Les moyens', 'Les prévisions financières', 'Le calendrier'].forEach((x) => som.appendChild(el('li', null, x)));
      couv.appendChild(el('h2', null, 'Sommaire'));
      couv.appendChild(som);
      doc.appendChild(couv);

      const partie = (n, titre, saut) => { const s = el('section', saut ? 'ds-partie ds-saut' : 'ds-partie'); s.appendChild(el('h2', null, `${n}. ${titre}`)); doc.appendChild(s); return s; };

      // 1 à 3
      paragraphes(partie(1, 'Résumé du projet'), v('resume'));
      paragraphes(partie(2, 'Le porteur de projet'), sectionsTexte('parcours'));
      paragraphes(partie(3, 'L’offre'), sectionsTexte('offre'));

      // 4. Marché
      const m = partie(4, 'Le marché et la clientèle');
      paragraphes(m, sectionsTexte('marche'), 'Clientèle cible et positionnement à compléter.');
      if (etude) {
        m.appendChild(el('h3', null, `Étude de marché locale : ${etude.activite}`));
        tableau(m, ['Zone', 'Habitants', 'Concurrents', 'Pour 10 000 habitants', 'Habitants par concurrent'], etude.zones, `Entreprises actives de l’activité (répertoire Sirene, ${dateFr(etude.date)})`);
        if (etude.verdict) m.appendChild(el('p', 'ds-cle', neutre(etude.verdict).replace(/^Ton département/, 'Le département')));
        if (etude.zone) { m.appendChild(el('h3', null, 'Zone de chalandise')); m.appendChild(el('p', null, etude.zone.texte)); if (etude.zone.verdict) m.appendChild(el('p', 'ds-cle', neutre(etude.zone.verdict))); if (etude.zone.communes) m.appendChild(el('p', 'ds-petit', etude.zone.communes)); }
        if (etude.ca) { m.appendChild(el('h3', null, 'Chiffre d’affaires des concurrents')); m.appendChild(el('p', null, etude.ca)); }
        if (etude.evolution) {
          m.appendChild(el('h3', null, 'Évolution du marché sur 5 ans'));
          tableau(m, ['Année', 'Créations', 'Fermetures', 'Solde'], etude.evolution.lignes);
          m.appendChild(el('p', 'ds-cle', neutre(etude.evolution.verdict)));
        }
        if (etude.concurrents && etude.concurrents.length) {
          m.appendChild(el('h3', null, 'Principaux concurrents identifiés'));
          const ul = el('ul', 'ds-petit');
          etude.concurrents.forEach((x) => ul.appendChild(el('li', null, x)));
          m.appendChild(ul);
        }
        m.appendChild(el('p', 'ds-source', 'Sources : répertoire Sirene de l’INSEE (API Recherche d’entreprises), populations légales INSEE en vigueur en 2026, comptes annuels publiés. Calculs : Logimalin, étude de marché locale.'));
      }
      if (swot.some((x) => v(x.id))) {
        m.appendChild(el('h3', null, 'Forces, faiblesses, opportunités et menaces'));
        const g = el('div', 'ds-swot');
        swot.forEach((x) => {
          const c = el('div', `ds-sw ds-sw-${x.id}`);
          c.appendChild(el('strong', null, x.titre));
          const ul = el('ul');
          (v(x.id) || 'À compléter.').split(/\n/).map((l) => l.replace(/^[-•*]\s*/, '').trim()).filter(Boolean).forEach((l) => ul.appendChild(el('li', null, l)));
          c.appendChild(ul); g.appendChild(c);
        });
        m.appendChild(g);
      }

      paragraphes(partie(5, 'La stratégie commerciale'), sectionsTexte('strategie'));
      paragraphes(partie(6, 'Les moyens'), [v('statut') ? `Forme juridique envisagée : ${v('statut')}.` : '', sectionsTexte('moyens')].filter(Boolean).join('\n'));

      // 7. Chiffres
      const f = partie(7, 'Les prévisions financières', true);
      if (bp) {
        const h = bp.hypotheses;
        f.appendChild(el('h3', null, 'Hypothèses'));
        const ul = el('ul');
        [
          `Chiffre d’affaires de la 1re année : ${eur(h.ca1)}, puis ${h.croissance} % de croissance par an`,
          `Achats et coûts variables : ${h.coutsVariables} % du chiffre d’affaires`,
          `Charges fixes : ${eur(h.fixesMois)} par mois`,
          `Rémunération du dirigeant : ${eur(h.remuMois)} par mois${h.salairesMois ? `, salaires : ${eur(h.salairesMois)} par mois` : ''}`,
          `Investissements : ${eur(h.investissements)}, amortis sur ${h.dureeAmort} ans`,
          h.pret ? `Prêt bancaire : ${eur(h.pret)} sur ${h.dureePret} ans à ${String(h.taux).replace('.', ',')} %` : 'Pas de prêt bancaire',
        ].forEach((x) => ul.appendChild(el('li', null, x)));
        f.appendChild(ul);
        tableau(f, bp.cr[0].map((x, i) => (i ? x : 'Compte de résultat prévisionnel')), bp.cr.slice(1).map((r) => [r[0] === 'Ta rémunération' ? 'Rémunération du dirigeant' : r[0], ...r.slice(1).map(eur)]));
        const caL = ligneCr(/^Chiffre/), resL = ligneCr(/^Résultat/);
        if (caL && resL) f.appendChild(graphique(caL.slice(1), resL.slice(1), bp.seuil));
        f.appendChild(el('h3', null, 'Plan de financement initial'));
        const n = Math.max(bp.besoins.length, bp.ress.length);
        tableau(f, ['Besoins', 'Montant', 'Ressources', 'Montant'], [
          ...Array.from({ length: n }, (_, i) => [bp.besoins[i] ? bp.besoins[i][0] : '', bp.besoins[i] ? eur(bp.besoins[i][1]) : '', bp.ress[i] ? bp.ress[i][0] : '', bp.ress[i] ? eur(bp.ress[i][1]) : '']),
          ['Total', eur(bp.totB), 'Total', eur(bp.totR)],
        ]);
        f.appendChild(el('h3', null, 'Seuil de rentabilité'));
        f.appendChild(el('p', 'ds-cle', bp.seuil
          ? `${eur(bp.seuil)} de chiffre d’affaires par an, soit ${eur(bp.seuil / 12)} par mois, rémunération du dirigeant comprise. ` + (h.ca1 >= bp.seuil ? 'Le prévisionnel l’atteint dès la première année.' : `Le chiffre d’affaires de première année est inférieur de ${eur(bp.seuil - h.ca1)} : le seuil est visé à partir de la deuxième année.`)
          : 'Seuil non calculable : les coûts variables représentent 100 % du chiffre d’affaires.'));
        const treso = (bp.cr.find((r) => /^Trésorerie/.test(r[0])) || []).slice(1);
        const constats = [];
        if (bp.totR < bp.totB) constats.push(`Besoin de financement restant à couvrir : ${eur(bp.totB - bp.totR)}.`);
        if (treso.length && Math.min(...treso) < 0) constats.push('La trésorerie devient négative sur la période : le montage financier doit être renforcé.');
        if (!constats.length) constats.push('Le financement couvre les besoins de départ et la trésorerie reste positive sur les 3 ans.');
        constats.forEach((x) => f.appendChild(el('p', null, x)));
        f.appendChild(el('p', 'ds-source', 'Prévisionnel établi par le porteur de projet à partir de ses hypothèses (montants hors taxe).'));
      } else paragraphes(f, '', 'Prévisionnel à réaliser.');

      paragraphes(partie(8, 'Le calendrier'), sectionsTexte('calendrier'));
      doc.hidden = false;
      return doc;
    };
    const sectionsTexte = (id) => $(`ds-${id}`).value;

    // Barres du chiffre d'affaires et du résultat sur 3 ans, avec la ligne du seuil de rentabilité (SVG).
    const graphique = (ca, res, seuil) => {
      const NS = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(NS, 'svg');
      const W = 640, H = 230, b = 190, haut = 160, x0 = 70;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`); svg.setAttribute('class', 'ds-graph'); svg.setAttribute('role', 'img');
      svg.setAttribute('aria-label', 'Chiffre d’affaires et résultat sur 3 ans');
      const max = Math.max(...ca, seuil || 0, 1);
      const y = (n) => b - (Math.max(n, 0) / max) * haut;
      const add = (tag, at, txt) => { const e = document.createElementNS(NS, tag); Object.entries(at).forEach(([k, x]) => e.setAttribute(k, x)); if (txt != null) e.textContent = txt; svg.appendChild(e); return e; };
      const k = (n) => `${Math.round(n / 1000).toLocaleString('fr-FR')} k€`;
      add('line', { x1: x0, y1: b, x2: W - 10, y2: b, stroke: '#999' });
      ca.forEach((c, i) => {
        const cx = x0 + 40 + i * 180;
        add('rect', { x: cx, y: y(c), width: 60, height: b - y(c), fill: '#3d5afe', rx: 3 });
        add('text', { x: cx + 30, y: y(c) - 5, 'text-anchor': 'middle', 'font-size': 12, fill: '#1a1a1a' }, k(c));
        add('rect', { x: cx + 66, y: y(res[i]), width: 40, height: b - y(res[i]), fill: res[i] >= 0 ? '#f2b632' : '#d64545', rx: 3 });
        add('text', { x: cx + 86, y: y(res[i]) - 5, 'text-anchor': 'middle', 'font-size': 11, fill: '#1a1a1a' }, k(res[i]));
        add('text', { x: cx + 53, y: b + 16, 'text-anchor': 'middle', 'font-size': 12, fill: '#444' }, `Année ${i + 1}`);
      });
      if (seuil) {
        add('line', { x1: x0, y1: y(seuil), x2: W - 10, y2: y(seuil), stroke: '#2438b8', 'stroke-width': 2, 'stroke-dasharray': '6 4' });
        add('text', { x: x0 - 6, y: y(seuil) + 4, 'text-anchor': 'end', 'font-size': 11, fill: '#2438b8' }, 'Seuil');
      }
      const lg = [['#3d5afe', 'Chiffre d’affaires'], ['#f2b632', 'Résultat avant impôt'], ['#2438b8', 'Seuil de rentabilité']];
      lg.forEach(([c, t], i) => { add('rect', { x: x0 + i * 180, y: H - 12, width: 12, height: 10, fill: c }); add('text', { x: x0 + 18 + i * 180, y: H - 3, 'font-size': 11, fill: '#444' }, t); });
      const fig = el('figure', 'ds-fig'); fig.appendChild(svg); return fig;
    };

    const mesurer = (e) => { try { navigator.sendBeacon(`/api/mesure/${e}`); } catch (err) { /* sans importance */ } };
    $('ds-apercu').addEventListener('click', () => { mesurer('dossier-apercu'); construire().scrollIntoView({ behavior: 'smooth' }); });
    $('ds-go').addEventListener('click', () => {
      mesurer('dossier-pdf');
      const doc = construire();
      // Le dossier passe directement sous <body> le temps de l'impression : tout le reste est masqué (display: none),
      // ce qui laisse le navigateur découper le document en pages A4.
      const place = doc.nextSibling, parent = doc.parentNode;
      document.body.appendChild(doc);
      document.documentElement.classList.add('print-dossier');
      const remettre = () => {
        document.documentElement.classList.remove('print-dossier');
        parent.insertBefore(doc, place);
        window.removeEventListener('afterprint', remettre);
      };
      window.addEventListener('afterprint', remettre);
      window.print();
    });
  })();
</script>

<style>
  .dossier fieldset { border: 0; padding: 0; margin: 14px 0 0; }
  .dossier legend { font-family: var(--display); font-weight: 700; font-size: .95rem; padding: 0; margin-top: 8px; color: var(--accent); }
  .dossier .row { grid-template-columns: 1fr 1fr; }
  @media (max-width: 600px) { .dossier .row { grid-template-columns: 1fr; } }
  .dossier textarea { width: 100%; font: inherit; font-size: .95rem; padding: 9px 12px; border: 1.5px solid var(--line); border-radius: 10px; background: var(--paper); color: var(--ink); }
  .dossier .small { font-size: .85rem; color: var(--muted); margin: 2px 0 6px; }
  .ds-sec { margin-top: 12px; }
  .ds-sources { display: grid; gap: 8px; margin: 10px 0; }
  .ds-src { padding: 10px 12px; border-radius: 10px; background: var(--sun-soft); font-size: .92rem; }
  .ds-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }

