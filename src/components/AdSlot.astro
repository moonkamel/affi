---
// Bloc publicitaire. Hauteur réservée pour que la page ne bouge pas au chargement.
// Régie Adsterra : « outil » = Native Banner (sous le contenu), « fin » = Banner 300×250 (fin d'article).
// Régie AdSense (si provider = 'adsense') : display adaptatif, script chargé une seule fois par le premier bloc.
import { SITE } from '../data/site';
interface Props { place: 'outil' | 'fin'; first?: boolean }
const { place, first = false } = Astro.props;
const { provider, adsterra, client } = SITE.ads;
const slot = SITE.ads.slots[place];
const bannerOptions = `atOptions = { 'key': '${adsterra.banner}', 'format': 'iframe', 'height': 250, 'width': 300, 'params': {} };`;
---
<aside class={`pub pub-${place}`} aria-label="Publicité" data-pagefind-ignore>
  <span class="pub-mention">Publicité</span>
  {provider === 'adsterra' ? (
    place === 'outil' ? (
      <Fragment>
        <script is:inline async="async" data-cfasync="false" src={`${adsterra.host}/21/${adsterra.native}`}></script>
        <div id={`container-${adsterra.native}`}></div>
      </Fragment>
    ) : (
      <div class="pub-banniere">
        <script is:inline set:html={bannerOptions}></script>
        <script is:inline src={`${adsterra.host}/22/${adsterra.banner}`}></script>
      </div>
    )
  ) : (
    <Fragment>
      {first && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${client}`} crossorigin="anonymous"></script>}
      <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </Fragment>
  )}
</aside>

<style>
  .pub { margin: 32px 0; min-height: 280px; padding: 8px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .pub-fin { min-height: 280px; }
  .pub-banniere { display: flex; justify-content: center; min-height: 250px; }
  .pub-mention { display: block; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
</style>
