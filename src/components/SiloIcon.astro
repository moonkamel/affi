---
// Icônes « papier découpé » par rubrique : formes plates superposées, couleurs tirées des tokens
// (elles suivent donc le thème clair/sombre). Ombre décalée = papier posé sur la page.
import type { Silo } from '../data/site';
interface Props { silo: Silo; class?: string }
const { silo, class: cls } = Astro.props;
const C = { ink: 'var(--ink)', card: 'var(--card)', accent: 'var(--accent)', sun: 'var(--sun)', mint: 'var(--mint)', peach: 'var(--peach)', sky: 'var(--sky)' };
---
<svg class={cls} viewBox="0 0 48 48" aria-hidden="true">
  {silo === 'facturation' && (
    <g>
      <path d="M12 7h22l4 4v31l-4-2.5-4 2.5-4-2.5-4 2.5-4-2.5-4 2.5V9a2 2 0 0 1 2-2z" style={`fill:${C.ink}`} transform="translate(2 2)" opacity=".18" />
      <path d="M12 7h22l4 4v31l-4-2.5-4 2.5-4-2.5-4 2.5-4-2.5-4 2.5V9a2 2 0 0 1 2-2z" style={`fill:${C.card};stroke:${C.ink};stroke-width:1.5`} />
      <rect x="15" y="14" width="14" height="3" rx="1.5" style={`fill:${C.accent}`} />
      <rect x="15" y="21" width="17" height="2" rx="1" style={`fill:${C.ink}`} opacity=".35" />
      <rect x="15" y="26" width="12" height="2" rx="1" style={`fill:${C.ink}`} opacity=".35" />
      <circle cx="31" cy="32" r="5" style={`fill:${C.sun}`} />
    </g>
  )}
  {silo === 'comptabilite' && (
    <g>
      <rect x="11" y="7" width="26" height="34" rx="5" style={`fill:${C.ink}`} transform="translate(2 2)" opacity=".18" />
      <rect x="11" y="7" width="26" height="34" rx="5" style={`fill:${C.mint};stroke:${C.ink};stroke-width:1.5`} />
      <rect x="15" y="11" width="18" height="8" rx="2" style={`fill:${C.card};stroke:${C.ink};stroke-width:1.2`} />
      {[0, 1, 2].map((r) => [0, 1, 2].map((c) => <rect x={15 + c * 6.5} y={23 + r * 5.5} width="5" height="4" rx="1.2" style={`fill:${r === 2 && c === 2 ? C.accent : C.card}`} />))}
    </g>
  )}
  {silo === 'encaissement' && (
    <g>
      <rect x="7" y="13" width="32" height="22" rx="4" style={`fill:${C.ink}`} transform="translate(2 2)" opacity=".18" />
      <rect x="7" y="13" width="32" height="22" rx="4" style={`fill:${C.accent};stroke:${C.ink};stroke-width:1.5`} />
      <rect x="11" y="18" width="8" height="6" rx="1.5" style={`fill:${C.sun}`} />
      <rect x="11" y="28" width="18" height="2.5" rx="1.2" style={`fill:${C.card}`} opacity=".8" />
      <circle cx="37" cy="33" r="7" style={`fill:${C.peach};stroke:${C.ink};stroke-width:1.5`} />
      <path d="M34 33.2l2.2 2.2 4-4.4" fill="none" style={`stroke:${C.ink}`} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}
  {silo === 'site-internet' && (
    <g>
      <rect x="6" y="9" width="36" height="28" rx="4" style={`fill:${C.ink}`} transform="translate(2 2)" opacity=".18" />
      <rect x="6" y="9" width="36" height="28" rx="4" style={`fill:${C.card};stroke:${C.ink};stroke-width:1.5`} />
      <path d="M6 13a4 4 0 0 1 4-4h28a4 4 0 0 1 4 4v3H6z" style={`fill:${C.sky}`} />
      <circle cx="10.5" cy="12.6" r="1.3" style={`fill:${C.ink}`} />
      <circle cx="14.5" cy="12.6" r="1.3" style={`fill:${C.ink}`} />
      <rect x="10" y="20" width="13" height="12" rx="2" style={`fill:${C.peach}`} />
      <rect x="26" y="21" width="12" height="2.5" rx="1.2" style={`fill:${C.accent}`} />
      <rect x="26" y="26" width="9" height="2" rx="1" style={`fill:${C.ink}`} opacity=".35" />
      <path d="M34 34l6 6" style={`stroke:${C.ink}`} stroke-width="2" stroke-linecap="round" />
      <path d="M31 31l9 3-4 2-2 4z" style={`fill:${C.sun};stroke:${C.ink};stroke-width:1.2`} stroke-linejoin="round" />
    </g>
  )}
  {silo === 'crm' && (
    <g>
      <circle cx="18" cy="17" r="7" style={`fill:${C.peach};stroke:${C.ink};stroke-width:1.5`} />
      <path d="M6 38c1-7 6-11 12-11s11 4 12 11z" style={`fill:${C.accent};stroke:${C.ink};stroke-width:1.5`} stroke-linejoin="round" />
      <circle cx="33" cy="19" r="5.5" style={`fill:${C.mint};stroke:${C.ink};stroke-width:1.5`} />
      <path d="M27 38c.6-5.5 3.5-9 7-9s7 3.5 8 9z" style={`fill:${C.sun};stroke:${C.ink};stroke-width:1.5`} stroke-linejoin="round" />
    </g>
  )}
  {silo === 'equipe' && (
    <g>
      <rect x="8" y="10" width="32" height="30" rx="4" style={`fill:${C.ink}`} transform="translate(2 2)" opacity=".18" />
      <rect x="8" y="10" width="32" height="30" rx="4" style={`fill:${C.card};stroke:${C.ink};stroke-width:1.5`} />
      <path d="M8 14a4 4 0 0 1 4-4h24a4 4 0 0 1 4 4v4H8z" style={`fill:${C.accent}`} />
      <rect x="15" y="6" width="3" height="8" rx="1.5" style={`fill:${C.ink}`} />
      <rect x="30" y="6" width="3" height="8" rx="1.5" style={`fill:${C.ink}`} />
      <rect x="12" y="22" width="7" height="5" rx="1.2" style={`fill:${C.sun}`} />
      <rect x="21" y="22" width="7" height="5" rx="1.2" style={`fill:${C.mint}`} />
      <rect x="30" y="22" width="6" height="5" rx="1.2" style={`fill:${C.peach}`} />
      <rect x="12" y="30" width="7" height="5" rx="1.2" style={`fill:${C.mint}`} />
      <rect x="21" y="30" width="7" height="5" rx="1.2" style={`fill:${C.sky}`} />
    </g>
  )}
  {silo === 'metiers' && (
    <g>
      <rect x="6" y="17" width="36" height="22" rx="4" style={`fill:${C.ink}`} transform="translate(2 2)" opacity=".18" />
      <path d="M18 17v-4a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v4" fill="none" style={`stroke:${C.ink}`} stroke-width="2" />
      <rect x="6" y="17" width="36" height="22" rx="4" style={`fill:${C.sun};stroke:${C.ink};stroke-width:1.5`} />
      <rect x="6" y="25" width="36" height="3" style={`fill:${C.ink}`} opacity=".15" />
      <rect x="20" y="23" width="8" height="7" rx="1.5" style={`fill:${C.card};stroke:${C.ink};stroke-width:1.2`} />
    </g>
  )}
  {silo === 'comparatifs' && (
    <g>
      <path d="M24 8v30M14 38h20" style={`stroke:${C.ink}`} stroke-width="2" stroke-linecap="round" />
      <path d="M10 14h28" style={`stroke:${C.ink}`} stroke-width="2" stroke-linecap="round" />
      <path d="M4 27l6-13 6 13a6 6 0 0 1-12 0z" style={`fill:${C.sky};stroke:${C.ink};stroke-width:1.5`} stroke-linejoin="round" />
      <path d="M32 27l6-13 6 13a6 6 0 0 1-12 0z" style={`fill:${C.peach};stroke:${C.ink};stroke-width:1.5`} stroke-linejoin="round" />
      <circle cx="24" cy="8" r="3" style={`fill:${C.sun};stroke:${C.ink};stroke-width:1.5`} />
    </g>
  )}
  {silo === 'alternatives' && (
    <g>
      <path d="M8 16h26l-5-5M40 32H14l5 5" fill="none" style={`stroke:${C.ink}`} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="10" cy="16" r="5" style={`fill:${C.mint};stroke:${C.ink};stroke-width:1.5`} />
      <circle cx="38" cy="32" r="5" style={`fill:${C.peach};stroke:${C.ink};stroke-width:1.5`} />
    </g>
  )}
  {silo === 'avis' && (
    <g>
      <path d="M24 6l5.3 11 12 1.6-8.8 8.3 2.2 11.9L24 33l-10.7 5.8 2.2-11.9-8.8-8.3 12-1.6z" style={`fill:${C.ink}`} transform="translate(2 2)" opacity=".18" />
      <path d="M24 6l5.3 11 12 1.6-8.8 8.3 2.2 11.9L24 33l-10.7 5.8 2.2-11.9-8.8-8.3 12-1.6z" style={`fill:${C.sun};stroke:${C.ink};stroke-width:1.5`} stroke-linejoin="round" />
      <circle cx="24" cy="23" r="4" style={`fill:${C.card}`} />
    </g>
  )}
  {silo === 'creer' && (
    <g>
      <path d="M24 6c6 4 9 11 9 18v8H15v-8c0-7 3-14 9-18z" style={`fill:${C.ink}`} transform="translate(2 2)" opacity=".18" />
      <path d="M15 28l-6 6v4l6-2zM33 28l6 6v4l-6-2z" style={`fill:${C.peach};stroke:${C.ink};stroke-width:1.5`} stroke-linejoin="round" />
      <path d="M24 6c6 4 9 11 9 18v8H15v-8c0-7 3-14 9-18z" style={`fill:${C.card};stroke:${C.ink};stroke-width:1.5`} stroke-linejoin="round" />
      <circle cx="24" cy="19" r="4" style={`fill:${C.sky};stroke:${C.ink};stroke-width:1.3`} />
      <path d="M20 32h8l-1.5 7c-.4 1.6-4.6 1.6-5 0z" style={`fill:${C.sun};stroke:${C.ink};stroke-width:1.3`} stroke-linejoin="round" />
      <rect x="18" y="26" width="12" height="2.5" rx="1.2" style={`fill:${C.accent}`} />
    </g>
  )}
  {silo === 'outils' && (
    <g>
      <path d="M12 38L30 20" style={`stroke:${C.ink}`} stroke-width="5" stroke-linecap="round" />
      <path d="M12 38L30 20" style={`stroke:${C.accent}`} stroke-width="2.6" stroke-linecap="round" />
      <path d="M33 7l1.8 4.4 4.4 1.8-4.4 1.8L33 19.4l-1.8-4.4-4.4-1.8 4.4-1.8z" style={`fill:${C.sun};stroke:${C.ink};stroke-width:1.2`} stroke-linejoin="round" />
      <circle cx="40" cy="26" r="2.5" style={`fill:${C.peach}`} />
      <circle cx="21" cy="11" r="2" style={`fill:${C.mint}`} />
    </g>
  )}
</svg>
