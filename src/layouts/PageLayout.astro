---
// Pages institutionnelles (à propos, mentions…) : texte simple + fil d'Ariane.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { abs, breadcrumbs, graph, organization } from '../lib/schema';
interface Props { title: string; seoTitle?: string; description: string; noindex?: boolean; schemaType?: 'AboutPage' | 'WebPage' }
const { title, seoTitle, description, noindex = false, schemaType = 'WebPage' } = Astro.props;
const path = Astro.url.pathname;
const crumbs = [{ name: 'Accueil', path: '/' }, { name: title, path }];
const page: Record<string, unknown> = { '@type': schemaType, '@id': abs(path) + '#page', name: title, url: abs(path), inLanguage: 'fr-FR' };
if (schemaType === 'AboutPage') page.mainEntity = organization();
---
<BaseLayout title={seoTitle ?? title} description={description} noindex={noindex} jsonLd={graph(page, breadcrumbs(crumbs))}>
  <div class="container"><div class="prose">
    <Breadcrumbs items={crumbs} />
    <header class="article-head"><h1>{title}</h1></header>
    <slot />
  </div></div>
</BaseLayout>
