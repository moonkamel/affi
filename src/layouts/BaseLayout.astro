---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { abs } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Objet JSON-LD complet (graph). */
  jsonLd?: object;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  image?: string;
  published?: Date;
  updated?: Date;
}
const {
  title,
  description,
  jsonLd,
  noindex = false,
  ogType = 'website',
  image = '/og-default.png',
  published,
  updated,
} = Astro.props;

// URL canonique toujours absolue, avec slash final (cohérent avec trailingSlash: 'always').
const canonical = abs(Astro.url.pathname);
// Marque ajoutée seulement si le titre reste sous 60 caractères (au-delà, Google tronque).
const branded = `${title} | ${SITE.name}`;
const fullTitle = title.includes(SITE.name) || branded.length > 60 ? title : branded;
const ogImage = abs(image);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="55C4598C8B721E07941B080753E6498E" />
    <script is:inline>
      // Mesure d'usage anonyme (sans cookie) : un appel par événement et par page vue, voir functions/api/mesure/.
      window.mesure = (ev) => { const v = (window.__mesures ||= new Set()); if (v.has(ev)) return; v.add(ev); try { navigator.sendBeacon('/api/mesure/' + ev); } catch (e) { /* sans importance */ } };
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr-FR" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content={SITE.author.name} />
    <meta name="theme-color" content="#11131b" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Logimalin : guides et comparatifs" href="/rss.xml" />

    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <nav class="nav-mobile" aria-label="Navigation rapide">
      <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>Accueil</a>
      <a href="/outils/" aria-current={Astro.url.pathname === '/outils/' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><rect x="13" y="4" width="7" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><rect x="4" y="13" width="7" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><rect x="13" y="13" width="7" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="2"/></svg>Outils</a>
      <button type="button" data-ouvrir-recherche><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Rechercher</button>
      <a href="/#logiciels"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v14H5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 15l3-3 2 2 3-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Logiciels</a>
    </nav>
    <button type="button" id="haut-de-page" class="haut-de-page" aria-label="Revenir en haut de la page" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 14l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <script>import '../scripts/ameliorations.ts';</script>
    <script is:inline>
      // Suivi des clics affiliés : /go/<slug>/ devient /go/<slug>/<page d'origine>/, compté dans les stats
      // serveur Cloudflare (voir docs/AFFILIATION.md). Le HTML garde l'URL courte ; les robots sans JS ne sont pas comptés ici.
      (() => {
        const from = location.pathname.slice(1) || 'accueil/';
        for (const a of document.querySelectorAll('a[href^="/go/"]')) {
          const m = a.getAttribute('href').match(/^\/go\/([^/]+)\/$/);
          if (m) a.setAttribute('href', `/go/${m[1]}/${from}`);
        }
      })();
    </script>
  </body>
</html>
