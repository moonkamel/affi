---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Toc from '../components/Toc.astro';
import Faq from '../components/Faq.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Related from '../components/Related.astro';
import SiloIcon from '../components/SiloIcon.astro';
import { SILOS, SITE } from '../data/site';
import { getSoftware } from '../data/software';
import Avatar from '../components/Avatar.astro';
import TestedBox from '../components/TestedBox.astro';
import Infographic from '../components/Infographic.astro';
import { autoForPage } from '../data/infographics';
import NewsletterBox from '../components/NewsletterBox.astro';
import { GROUPES_OUTILS } from '../data/outils';
// Articles où l'on propose la check-list facture électronique.
const NEWS_PAGES = /facture-electronique|e-reporting|factur-x|plateforme-agreee|annuaire-facturation|mentions-obligatoires|facture-excel|logiciel-facturation-auto-entrepreneur|logiciel-de-facturation/;
import { article, breadcrumbs, faqPage, graph, itemList, review } from '../lib/schema';
import { articlePath, getArticles, siloOf, toTile, type Article } from '../lib/articles';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props { entry: Article; headings: MarkdownHeading[] }
const { entry, headings } = Astro.props;
const d = entry.data;
const path = articlePath(entry);
const silo = siloOf(entry);

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: SILOS[silo].label, path: `/${silo}/` },
  { name: d.title, path },
];

// Maillage interne : liens explicites d'abord, complétés par les pages du même silo.
const all = await getArticles();
const explicit = d.related
  .map((id) => all.find((a) => a.id === id))
  .filter((a): a is Article => {
    return Boolean(a);
  });
const sameSilo = all.filter((a) => siloOf(a) === silo && a.id !== entry.id && !explicit.includes(a));
const related = [...explicit, ...sameSilo].slice(0, 4).map(toTile);

// Pages outils : les autres outils de la même famille, pour enchaîner sans repasser par le menu.
const groupe = d.type === 'outil' ? GROUPES_OUTILS.find((g) => g.outils.includes(entry.id)) : undefined;
const voisins = groupe ? groupe.outils.filter((id) => id !== entry.id && !d.related.includes(id)).map((id) => all.find((a) => a.id === id)).filter((a): a is Article => Boolean(a)).slice(0, 4) : [];

// Image de partage propre à l'article si elle a été générée (npm run og), sinon l'image par défaut.
const ogFile = `/og/${entry.id.replace(/\//g, '--')}.jpg`;
const ogImage = existsSync(join(process.cwd(), 'public', ogFile)) ? ogFile : '/og-default.png';

const nodes: object[] = [
  article({ path, title: d.title, description: d.description, published: d.published, updated: d.updated, image: ogImage }),
  breadcrumbs(crumbs),
];
if (d.products.length) nodes.push(itemList(path, d.products.map(getSoftware)));
if (d.review) nodes.push(review(path, getSoftware(d.review.product), d.review.rating, d.description));
if (d.faq.length) nodes.push(faqPage(d.faq));

// Temps de lecture (texte brut de l'article, à 230 mots par minute) et chapitres pour le sommaire flottant.
const mots = (entry.body ?? '').replace(/<[^>]+>|\{[^}]*\}|[#*_>`|-]/g, ' ').split(/\s+/).filter(Boolean).length;
// Les fiches logiciels (<ProductCard>) et les FAQ sont rendues à partir des données : environ 130 et 40 mots chacune.
const fiches = ((entry.body ?? '').match(/<ProductCard/g) ?? []).length;
const minutes = Math.max(1, Math.round((mots + fiches * 130 + d.faq.length * 40) / 230));
const chapitres = headings.filter((h) => h.depth === 2);
const suite = related[0];
const fmt = (x: Date) => x.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  title={d.seoTitle}
  description={d.description}
  jsonLd={graph(...nodes)}
  ogType="article"
  published={d.published}
  updated={d.updated}
  image={ogImage}
>
  <div class="lecture" aria-hidden="true" data-minutes={minutes}><i></i><span class="lecture-titre"></span></div>
  <article class="container">
    <div class="prose" data-pagefind-body>
      <div data-pagefind-ignore><Breadcrumbs items={crumbs} /></div>
      <header class="article-head">
        <a class="silo-pill" href={`/${silo}/`}><SiloIcon silo={silo} />{SILOS[silo].label}</a>
        <h1>{d.title}</h1>
        <div class="meta">
          <span class="who"><Avatar size={30} /><span>Par <a href={SITE.author.url} rel="author">{SITE.author.name}</a></span></span>
          <span>Mis à jour le <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></span>
          <span>Lecture : {minutes} min</span>
        </div>
      </header>
      {d.type === 'outil' && (
        <a class="aller-outil" data-aller-outil data-pagefind-ignore hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Accéder directement à l’outil
        </a>
      )}
      {d.tested && <TestedBox tested={d.tested} product={d.review?.product} />}
      {d.tldr.length > 0 && (
        <div class="tldr"><strong>L’essentiel en 30 secondes</strong><ul>{d.tldr.map((t) => <li set:html={t} />)}</ul></div>
      )}
      <Toc headings={headings} />
      <slot />
      {autoForPage(entry.id).map((g) => <Infographic slug={g.slug} heading="L’infographie à retenir" />)}
      {NEWS_PAGES.test(entry.id) && <NewsletterBox />}
      {voisins.length > 0 && (
        <section class="voisins" aria-labelledby="voisins-titre" data-pagefind-ignore>
          <h2 id="voisins-titre">Les autres outils « {groupe!.titre} »</h2>
          <div class="voisins-grille">
            {voisins.map((a) => (
              <a class="voisin" href={articlePath(a)}>
                <strong>{a.data.title.split(' : ')[0]}</strong>
                <span>{a.data.description}</span>
              </a>
            ))}
          </div>
          <p class="small"><a href={`/outils/#${groupe!.id}`}>Voir tous les outils gratuits</a></p>
        </section>
      )}
      <Faq items={d.faq} />
      <div data-pagefind-ignore><AuthorBox /><Related items={related} /></div>
    </div>
    {chapitres.length >= 3 && (
      <aside class="toc-flottant" aria-label="Dans cet article" data-pagefind-ignore>
        <div class="toc-flottant-tete"><svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="15" fill="none" stroke="var(--line)" stroke-width="3"/><circle class="toc-anneau" cx="18" cy="18" r="15" fill="none" stroke="url(#toc-degrade)" stroke-width="3" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100"/><defs><linearGradient id="toc-degrade"><stop offset="0" stop-color="var(--accent)"/><stop offset="1" stop-color="var(--sun)"/></linearGradient></defs></svg><span><b>Dans cet article</b><span class="toc-reste">{minutes} min de lecture</span></span></div>
        <ol>{chapitres.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </aside>
    )}
    {suite && (
      <aside class="suite" data-suite hidden aria-label="À lire ensuite" data-pagefind-ignore>
        <button type="button" class="suite-fermer" aria-label="Fermer la suggestion">×</button>
        <span class="suite-tete">À lire ensuite</span>
        <a href={suite.href}><strong>{suite.title}</strong><span>Lire l’article →</span></a>
      </aside>
    )}
  </article>
</BaseLayout>

<script>import '../scripts/article-anime.ts';</script>
