---
// Pages hub de chaque silo : elles concentrent les liens internes vers les articles du silo.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiloIcon from '../../components/SiloIcon.astro';
import { SILOS, type Silo } from '../../data/site';
import { abs, breadcrumbs, graph } from '../../lib/schema';
import { articlePath, getArticles, siloOf } from '../../lib/articles';
import OutilsVitrine from '../../components/OutilsVitrine.astro';
import { GROUPES_OUTILS, OUTILS_INFO, STOCKAGES_OUTILS, TYPES_OUTIL, type TypeOutil } from '../../data/outils';

export async function getStaticPaths() {
  // Pas de page hub vide (contenu mince = mauvais signal pour Google).
  const all = await getArticles();
  return Object.keys(SILOS)
    .filter((silo) => all.some((a) => siloOf(a) === silo))
    .map((silo) => ({ params: { silo } }));
}

const silo = Astro.params.silo as Silo;
const info = SILOS[silo];
const all = await getArticles();
const articles = all.filter((a) => siloOf(a) === silo);
// La page Outils reprend aussi les outils publiés dans d'autres rubriques (étude de marché, business plan…).
const autresOutils = silo === 'outils' ? all.filter((a) => siloOf(a) !== 'outils' && a.data.type === 'outil') : [];
// Sur /outils/, tous les outils (de toutes les rubriques) sont classés par besoin ; les autres silos gardent la grille simple.
const tousOutils = silo === 'outils' ? all.filter((a) => a.data.type === 'outil' || siloOf(a) === 'outils') : [];
const groupes = GROUPES_OUTILS.map((g) => ({ ...g, items: g.outils.map((id) => tousOutils.find((a) => a.id === id)).filter((a) => a !== undefined) })).filter((g) => g.items.length);
const classes = new Set(groupes.flatMap((g) => g.items.map((a) => a.id)));
const autres = tousOutils.filter((a) => !classes.has(a.id));
if (autres.length) groupes.push({ id: 'autres', titre: 'Autres outils', intro: '', outils: [], items: autres });
const path = `/${silo}/`;
// Page des outils : type, accroche et titre court de chaque outil, filtres par type.
const infoOutil = (a: (typeof all)[number]) => OUTILS_INFO[a.id] ?? { titre: a.data.title.split(' : ')[0], type: 'calculateur' as TypeOutil, accroche: a.data.description };
const typesPresents = (Object.keys(TYPES_OUTIL) as TypeOutil[]).map((t) => ({ t, n: tousOutils.filter((a) => infoOutil(a).type === t).length })).filter((x) => x.n);
const reprise = silo === 'outils' ? Object.fromEntries(tousOutils.map((a) => [articlePath(a), infoOutil(a).titre])) : {};
const stockages = Object.fromEntries(Object.entries(STOCKAGES_OUTILS).map(([k, id]) => [k, `/${id}/`]));
const crumbs = [{ name: 'Accueil', path: '/' }, { name: info.label, path }];

const intros: Record<Silo, string> = {
  facturation:
    'Depuis le 1er septembre 2026, toutes les entreprises doivent pouvoir recevoir des factures électroniques, et les TPE et micro-entrepreneurs devront les émettre à partir du 1er septembre 2027. C’est le moment de choisir un logiciel de facturation connecté à une plateforme agréée. Nos guides expliquent le calendrier simplement, nos comparatifs t’aident à choisir selon ton statut et ton métier.',
  comptabilite:
    'Tenir sa comptabilité soi-même, la confier à un expert-comptable ou combiner les deux : les logiciels de comptabilité en ligne automatisent aujourd’hui l’essentiel (banque, justificatifs, TVA). Nos comparatifs t’aident à choisir selon ton statut, ton volume et ton besoin d’accompagnement.',
  encaissement:
    'Terminal de paiement, caisse enregistreuse, lien de paiement : chaque commerce et chaque indépendant doit encaisser vite et au meilleur coût. Ici, on compare les frais réels (abonnement, commission, matériel) et les obligations comme la certification NF525.',
  'site-internet':
    'Site vitrine, boutique en ligne, page de vente : créer le site de son entreprise ne demande plus de développeur. Encore faut-il choisir le bon outil, au bon prix, sans s’enfermer. Nos guides comparent les créateurs de sites et hébergeurs selon ton projet.',
  crm:
    'Trouver des clients, suivre ses devis, relancer au bon moment et fidéliser : un CRM et un outil d’emailing bien choisis font gagner des ventes sans y passer ses soirées. Nos comparatifs sont pensés pour les TPE, pas pour les grands comptes.',
  equipe:
    'Dès le premier salarié, le planning, les heures et la préparation de la paie prennent du temps. Les logiciels de gestion d’équipe automatisent ces tâches et réduisent les erreurs. Voici lesquels choisir selon ton secteur et ta taille.',
  metiers:
    'Chaque métier a ses outils : un artisan a besoin de devis rapides sur chantier, un freelance d’une facturation simple et d’un CRM léger, un restaurant d’une caisse et d’un module de réservation. Retrouve ici le kit de logiciels complet pour ton activité, avec les prix et les priorités.',
  comparatifs:
    'Tu hésites entre deux logiciels ? Nos duels comparent les tarifs, les fonctions qui comptent vraiment au quotidien et le profil d’entreprise pour lequel chacun est fait, avec un verdict clair à la fin.',
  alternatives:
    'Abonnement qui grimpe, engagement trop long, commission, support absent : quand un logiciel ne convient plus, voici les alternatives sérieuses, classées selon ce que tu cherches à corriger.',
  avis:
    'Nos avis détaillés passent chaque logiciel au crible : tarifs, points forts, limites, profil idéal et pièges à éviter avant de signer.',
  creer:
    'Créer son entreprise, puis la faire tourner sans mauvaise surprise : business plan, choix du statut, aides à la création, déclarations URSSAF, impôt et CFE. Nos guides s’appuient sur les sources officielles (URSSAF, impots.gouv, France Travail, Bpifrance) et indiquent la date de leur dernière vérification.',
  outils:
    'Calculateurs, modèles PDF et générateurs pour facturer, convertir la TVA, fixer tes prix, préparer ton dossier pour la banque ou rédiger les documents d’un salarié. Sans inscription : tes données restent dans ton navigateur, et tes derniers calculs t’attendent quand tu reviens.',
};

const typeLabels: Record<string, string> = {
  comparatif: 'Comparatif',
  guide: 'Guide',
  avis: 'Avis',
  versus: 'Duel',
  alternatives: 'Alternatives',
  outil: 'Outil gratuit',
};

// Pages de rubrique : trois contenus mis en avant (comparatifs d'abord), puis le reste classé par type, en liste.
const ORDRE_TYPES = ['comparatif', 'versus', 'alternatives', 'avis', 'guide', 'outil'];
const TITRES_TYPES: Record<string, string> = { comparatif: 'Comparatifs', versus: 'Duels', alternatives: 'Alternatives', avis: 'Avis détaillés', guide: 'Guides', outil: 'Outils gratuits' };
const rubrique = articles;
const aLaUne = silo === 'outils' || rubrique.length < 7 ? [] : [...rubrique].sort((a, b) => ORDRE_TYPES.indexOf(a.data.type) - ORDRE_TYPES.indexOf(b.data.type)).slice(0, 3);
const sections = ORDRE_TYPES.map((t) => ({ id: `type-${t}`, titre: TITRES_TYPES[t], items: rubrique.filter((a) => a.data.type === t && !aLaUne.includes(a)) })).filter((x) => x.items.length);

// En-tête des rubriques : chiffres, dernière mise à jour et fil des articles mis à jour récemment.
const court = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
const recents = [...articles].sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime()).slice(0, 7);
const derniereMaj = recents[0] ? court(recents[0].data.updated) : '';
const NOMS: Record<string, [string, string]> = { comparatif: ['comparatif', 'comparatifs'], versus: ['duel', 'duels'], alternatives: ['page d’alternatives', 'pages d’alternatives'], avis: ['avis détaillé', 'avis détaillés'], guide: ['guide', 'guides'], outil: ['outil gratuit', 'outils gratuits'] };
const chiffres = ORDRE_TYPES.map((t) => { const n = articles.filter((a) => a.data.type === t).length; return { n, label: NOMS[t][n > 1 ? 1 : 0] }; }).filter((c) => c.n > 0).slice(0, 3);

const jsonLd = graph(
  {
    '@type': 'CollectionPage',
    '@id': abs(path) + '#page',
    name: info.title,
    description: info.description,
    url: abs(path),
    inLanguage: 'fr-FR',
    hasPart: (silo === 'outils' ? tousOutils : [...articles, ...autresOutils]).map((a) => ({ '@type': 'Article', headline: a.data.title, url: abs(articlePath(a)) })),
  },
  breadcrumbs(crumbs),
);
---
<BaseLayout title={info.seoTitle} description={info.description} jsonLd={jsonLd}>
  <div class="container" data-pagefind-body>
    <Breadcrumbs items={crumbs} />
    {silo === 'outils' ? (
      <section class="out-hero">
        <div>
          <span class="acc-kicker">Outils gratuits</span>
          <h1>{tousOutils.length} outils gratuits pour ta TPE</h1>
          <p class="hub-intro">{intros[silo]}</p>
        </div>
        <OutilsVitrine />
      </section>
    ) : (
      <section class="rub-hero" data-scene="flux">
        <span class="rub-mot" aria-hidden="true">{info.label}</span>
        <div class="rub-hero-texte">
          <div class="hub-head">
            <SiloIcon silo={silo} class="hub-icon" />
            <h1>{info.title}</h1>
          </div>
          <p class="hub-intro">{intros[silo]}</p>
          <div class="rub-chiffres">
            {chiffres.map((c) => <span><b data-compteur={c.n}>{c.n}</b>{c.label}</span>)}
            {derniereMaj && <span><b>{derniereMaj}</b>dernière mise à jour</span>}
          </div>
        </div>
        {recents.length > 2 && (
          <aside class="rub-fil" aria-labelledby="rub-fil-titre">
            <div class="rub-fil-tete"><span class="vit-direct"><i aria-hidden="true"></i><span id="rub-fil-titre">Mis à jour récemment</span></span></div>
            <div class="rub-fil-cadre">
              <ul class="rub-fil-liste">
                {recents.map((a) => (
                  <li><a href={articlePath(a)}><time datetime={a.data.updated.toISOString()}>{court(a.data.updated)}</time><span>{a.data.title}</span></a></li>
                ))}
              </ul>
              <ul class="rub-fil-liste rub-fil-copie" aria-hidden="true">
                {recents.map((a) => (
                  <li><a href={articlePath(a)} tabindex="-1"><time datetime={a.data.updated.toISOString()}>{court(a.data.updated)}</time><span>{a.data.title}</span></a></li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </section>
    )}
    {silo === 'outils' ? (
      <>
        <p class="out-modeles"><a href="/modeles/">Tu cherches un document prêt à l’emploi ? Voir la bibliothèque de modèles →</a></p>
        <section class="out-reprise" data-reprise={JSON.stringify({ titres: reprise, stockages })} hidden aria-labelledby="out-reprise-titre">
          <div class="out-reprise-tete"><h2 id="out-reprise-titre">Reprends où tu en étais</h2><span>Gardé sur cet appareil uniquement</span></div>
          <ul class="out-reprise-liste"></ul>
        </section>
        <div class="out-barre">
          <div class="out-barre-ligne">
            <div class="out-filtre">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
              <label for="out-q" class="sr-only">Filtrer les outils</label>
              <input id="out-q" type="search" autocomplete="off" enterkeyhint="search" placeholder="Filtrer : TVA, salarié, PDF…" />
            </div>
            <div class="out-types" role="group" aria-label="Type d’outil">
              <button type="button" aria-pressed="true" data-type="">Tous <span>{tousOutils.length}</span></button>
              {typesPresents.map(({ t, n }) => <button type="button" aria-pressed="false" data-type={t}>{TYPES_OUTIL[t].pluriel} <span>{n}</span></button>)}
            </div>
            <span class="out-compte" aria-live="polite"></span>
          </div>
          <nav class="out-ancres" aria-label="Catégories d’outils">
            {groupes.map((g) => <a href={`#${g.id}`}>{g.titre}</a>)}
          </nav>
        </div>
        {groupes.map((g, gi) => (
          <section class="out-groupe" aria-labelledby={g.id} data-groupe data-scene="flux">
            <div class="out-groupe-tete"><span class="out-chap" aria-hidden="true">{String(gi + 1).padStart(2, '0')}</span><h2 id={g.id}>{g.titre}</h2>{g.intro && <p>{g.intro}</p>}</div>
            <ul class="out-grille">
              {g.items.map((a) => {
                const o = infoOutil(a);
                return (
                  <li data-outil data-type={o.type} data-cles={`${o.titre} ${o.cles ?? ''} ${o.accroche} ${g.titre} ${TYPES_OUTIL[o.type].label}`}>
                    <a class={`acc-carte t-${o.type}`} href={articlePath(a)}>
                      <span class="out-badges"><span class="acc-type">{TYPES_OUTIL[o.type].label}</span>{o.nouveau && <span class="out-nouveau">Nouveau</span>}</span>
                      <strong>{o.titre}</strong>
                      <span>{o.accroche}</span>
                      <span class="out-action">{TYPES_OUTIL[o.type].action} →</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
        <section class="out-fin" data-scene="flux" aria-labelledby="out-fin-titre">
          <svg class="mm-etoile" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5l2.6 7.9 7.9 2.6-7.9 2.6L12 22.5l-2.6-7.9L1.5 12l7.9-2.6z" fill="currentColor"/></svg>
          <h2 id="out-fin-titre">Pas de compte, pas d’abonnement, pas de piège</h2>
          <div class="out-compteurs">
            <span><b data-compteur={tousOutils.length}>{tousOutils.length}</b>outils gratuits</span>
            <span><b data-compteur="0">0</b>compte à créer</span>
            <span><b data-compteur="0" data-suffixe=" €">0 €</b>à payer</span>
          </div>
          <p>Tes saisies restent dans ton navigateur, et tes derniers calculs t’attendent quand tu reviens.</p>
          <a class="acc-bande-btn mm-btn" href="/modeles/">Voir aussi les modèles de documents</a>
        </section>
        <div class="out-vide" hidden>
          <strong>Aucun outil pour « <span></span> »</strong>
          <p>Essaie un mot plus court, ou cherche dans les guides.</p>
          <button type="button" class="btn" data-tout>Tout afficher</button>
        </div>
      </>
    ) : (
      <>
        {aLaUne.length > 0 && (
          <section class="rub-une" aria-labelledby="rub-une-titre" data-scene="flux">
            <h2 id="rub-une-titre" class="rub-titre">À lire en premier</h2>
            <ol class="rub-une-liste">
              {aLaUne.map((a, i) => (
                <li style={`--i:${i}`}><a href={articlePath(a)}>
                  <span class="rub-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="rub-type">{typeLabels[a.data.type]}</span>
                  <strong>{a.data.title}</strong>
                  <span class="rub-desc">{a.data.description}</span>
                </a></li>
              ))}
            </ol>
          </section>
        )}
        {sections.length > 1 && (
          <nav class="rub-ancres" aria-label="Types de contenus">
            {sections.map((x) => <a href={`#${x.id}`}>{x.titre} <span>{x.items.length}</span></a>)}
          </nav>
        )}
        {sections.map((x) => (
          <section class="rub-section" aria-labelledby={x.id}>
            <h2 id={x.id} class="rub-titre">{x.titre} <span>{x.items.length}</span></h2>
            <ul class="rub-liste">
              {x.items.map((a) => (
                <li><a href={articlePath(a)}>
                  <strong>{a.data.title}</strong>
                  <span class="rub-desc">{a.data.description}</span>
                </a></li>
              ))}
            </ul>
          </section>
        ))}
      </>
    )}
  </div>
</BaseLayout>

<script>
  // Chaque module ne s'active que si ses éléments sont présents sur la page (outils ou rubrique).
  import '../../scripts/scenes.ts';
  import '../../scripts/outils-anime.ts';
  import '../../scripts/rubrique-anime.ts';
</script>

{silo === 'outils' && (
  <script is:inline>
    (() => {
      const q = document.getElementById('out-q');
      if (!q) return;
      const items = [...document.querySelectorAll('[data-outil]')];
      const groupes = [...document.querySelectorAll('[data-groupe]')];
      const vide = document.querySelector('.out-vide'), compte = document.querySelector('.out-compte');
      const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      let type = '';
      const filtrer = () => {
        const mots = norm(q.value.trim()).split(/\s+/).filter(Boolean);
        let n = 0;
        items.forEach((li) => {
          const ok = (!type || li.dataset.type === type) && mots.every((m) => norm(li.dataset.cles).includes(m));
          li.hidden = !ok; if (ok) n++;
        });
        groupes.forEach((g) => { g.hidden = !g.querySelector('[data-outil]:not([hidden])'); });
        vide.hidden = n > 0; vide.querySelector('span').textContent = q.value.trim();
        compte.textContent = n === items.length ? '' : `${n} outil${n > 1 ? 's' : ''} sur ${items.length}`;
      };
      q.addEventListener('input', filtrer);
      const boutons = [...document.querySelectorAll('[data-type]')].filter((b) => b.tagName === 'BUTTON');
      boutons.forEach((b) => b.addEventListener('click', () => {
        type = b.dataset.type; boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); filtrer();
      }));
      document.querySelector('[data-tout]').addEventListener('click', () => { q.value = ''; boutons[0].click(); q.focus(); });
      const init = new URLSearchParams(location.search).get('q');
      if (init) { q.value = init; filtrer(); }

      // Reprends où tu en étais : outils utilisés sur cet appareil (mémoire des calculateurs et des modèles).
      const zone = document.querySelector('[data-reprise]');
      try {
        const { titres, stockages } = JSON.parse(zone.dataset.reprise);
        const derniers = JSON.parse(localStorage.getItem('logimalin-reprise') || '{}');
        const vus = new Map();
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          const m = k && k.match(/^logimalin-calcul:([^:]+):/);
          const p = m ? m[1] : stockages[k];
          if (p && titres[p] && !vus.has(p)) vus.set(p, derniers[p] || { t: 0 });
        }
        const liste = [...vus.entries()].sort((a, b) => (b[1].t || 0) - (a[1].t || 0)).slice(0, 4);
        if (!liste.length) return;
        zone.querySelector('ul').replaceChildren(...liste.map(([p, d]) => {
          const li = document.createElement('li');
          const a = document.createElement('a'); a.href = p; a.className = 'out-reprise-carte';
          const t = document.createElement('strong'); t.textContent = titres[p];
          const s = document.createElement('span'); s.textContent = d.r ? `Dernier résultat : ${d.r}` : 'Tes valeurs sont gardées';
          const r = document.createElement('b'); r.textContent = 'Reprendre';
          const txt = document.createElement('span'); txt.className = 'out-reprise-texte'; txt.append(t, s);
          a.append(txt, r); li.append(a); return li;
        }));
        zone.hidden = false;
      } catch { /* stockage indisponible */ }
    })();
  </script>
)}
