---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SILOS } from '../data/site';
import { graph, organization, website, person } from '../lib/schema';
import { articlePath, getArticles, siloOf } from '../lib/articles';

const articles = await getArticles();
const featured = [
  'facturation/facture-electronique-auto-entrepreneur',
  'outils/modele-facture-gratuit',
  'site-internet/creer-un-site-internet',
  'facturation/facture-electronique-2026',
  'facturation/logiciel-de-facturation',
  'encaissement/terminal-de-paiement',
  'comptabilite/logiciel-comptabilite',
  'facturation/plateforme-agreee-facture-electronique',
]
  .map((id) => articles.find((a) => a.id === id))
  .filter((a) => a !== undefined);
const needs = (['facturation', 'comptabilite', 'encaissement', 'site-internet', 'crm', 'equipe'] as const).filter((s) =>
  articles.some((a) => siloOf(a) === s),
);
const metiers = articles.filter((a) => siloOf(a) === 'metiers' && a.id.includes('/logiciels-'));
---
<BaseLayout
  title="Logimalin : logiciels pour TPE et indépendants comparés"
  description="Facturation, comptabilité, site internet, terminal de paiement, CRM : les meilleurs logiciels pour TPE et indépendants comparés, avec les prix 2026."
  jsonLd={graph(organization(), website(), person())}
>
  <section class="hero container">
    <span class="kicker">Comparatifs indépendants · prix vérifiés en {SITE.pricesChecked}</span>
    <h1>Les bons logiciels pour faire tourner ta TPE, comparés par un entrepreneur</h1>
    <p>Facturer, encaisser, tenir ta compta, trouver des clients, avoir un site : on compare les outils avec les vraies questions d’un dirigeant de petite entreprise. Combien ça coûte vraiment, combien de temps ça fait gagner, et pour qui c’est fait.</p>
    <p style="display:flex;gap:10px;flex-wrap:wrap">
      <a class="btn" href="/facturation/facture-electronique-auto-entrepreneur/">Facture électronique : ce qui change</a>
      <a class="btn btn-ghost" href="/outils/modele-facture-gratuit/">Créer une facture gratuite</a>
    </p>
  </section>

  <section class="container" aria-labelledby="besoins">
    <h2 id="besoins">De quoi as-tu besoin ?</h2>
    <div class="grid">
      {needs.map((s) => (
        <a class="tile" href={`/${s}/`}>
          <strong>{SILOS[s].title}</strong>
          <span>{SILOS[s].description}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container" aria-labelledby="metiers">
    <h2 id="metiers">Le kit complet par métier</h2>
    <div class="grid">
      {metiers.map((a) => (
        <a class="tile" href={articlePath(a)}>
          <strong>{a.data.title}</strong>
          <span>{a.data.description}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container" aria-labelledby="populaires">
    <h2 id="populaires">Les guides les plus consultés</h2>
    <div class="grid">
      {featured.map((a) => (
        <a class="tile" href={articlePath(a)}>
          <span class="kicker">{SILOS[siloOf(a)].label}</span>
          <strong>{a.data.title}</strong>
          <span>{a.data.description}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container" aria-labelledby="pourquoi">
    <h2 id="pourquoi">Pourquoi nous faire confiance ?</h2>
    <ul>
      <li><strong>Un regard d’entrepreneur</strong> : on juge les outils sur le temps gagné et le coût réel, pas sur la liste des fonctions. <a href="/a-propos/">Qui sommes-nous</a></li>
      <li><strong>Une méthode publique</strong> : critères et pondérations expliqués. <a href="/methodologie/">Notre méthodologie</a></li>
      <li><strong>Des prix datés</strong> : chaque page affiche sa date de mise à jour.</li>
      <li><strong>La transparence</strong> : les liens affiliés sont signalés et n’achètent pas les classements. <a href="/transparence-affiliation/">En savoir plus</a></li>
    </ul>
  </section>
</BaseLayout>
